NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://kaifzafry3110:Zafrykaif@namastenode.t42j3.mongodb.net/
LOG_LEVEL=info

# "user" reads groups as your own Telegram account (works for groups you are
# only a member of). "bot" uses a Bot API token (bot must be added to the chat).
TELEGRAM_MODE=user

# User mode: create an app at https://my.telegram.org -> API development tools,
# then run `npm run telegram:login` to generate TELEGRAM_SESSION.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Bot mode only
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Your private control bot (alerts, /status, /positions, /panic, trade approval).
# Create a bot with @BotFather and paste its token. Then send /start to it: it
# replies with your chat ID for TELEGRAM_CONTROL_CHAT_ID. Must not be the same
# token as TELEGRAM_BOT_TOKEN.
TELEGRAM_CONTROL_BOT_TOKEN=
TELEGRAM_CONTROL_CHAT_ID=

# 32-byte key used to encrypt Binance API keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# Safety switch: LIVE Binance accounts are never traded unless this is true.
BINANCE_ALLOW_LIVE=false

# Signals older than this (e.g. delivered after a reconnect) are not traded.
SIGNAL_MAX_AGE_SECONDS=120

# How often open trades are reconciled with Binance.
POSITION_SYNC_INTERVAL_MS=5000

# Dashboard: secret that signs login sessions (random if unset, so logins reset
# on restart) and the dashboard's URL, which is allowed to call this API.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
DASHBOARD_ORIGIN=http://localhost:3000
