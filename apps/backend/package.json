{
  "name": "@telegram-future-bot/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "setup": "tsx src/scripts/setup.ts",
    "telegram:login": "tsx src/scripts/telegram-login.ts",
    "telegram:chats": "tsx src/scripts/telegram-chats.ts",
    "signal:dry-run": "tsx src/scripts/signal-dry-run.ts",
    "diagnose": "tsx src/scripts/diagnose.ts"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.3",
    "express-rate-limit": "^7.4.1",
    "grammy": "^1.46.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.8.4",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "telegram": "^2.26.22",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.16.0",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
